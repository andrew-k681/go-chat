# Copy to .env (git-ignored) and fill in. Generate secrets with: openssl rand -base64 32

# --- signaling server (server/) ---
ADDR=:8080
ALLOW_ORIGINS=http://localhost:5173
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=

# Room events → Kafka. Leave KAFKA_BROKERS empty to disable.
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=room-events
# HMAC key for room_ref. Required with KAFKA_BROKERS; rotating it breaks room_ref continuity.
EVENTS_KEY=
# Production: KAFKA_TLS=true plus SCRAM credentials (separate users for producer and consumer).
# KAFKA_TLS=false
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USER=
# KAFKA_SASL_PASSWORD=

# --- stats service (server/cmd/stats) ---
STATS_ADDR=127.0.0.1:8081
KAFKA_GROUP=stats
STATS_TOKEN=
